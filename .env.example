# Copy to .env and fill in. Never commit .env.

# --- Database the application connects to (the unprivileged runtime role) ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=fintrace
DATABASE_USER=fintrace_app
DATABASE_PASSWORD=change-me

# --- Used only by scripts/bootstrap_db.py to create roles, the database and tables ---
# A PostgreSQL superuser. Leave the password unset to be prompted for it.
FINTRACE_DB_ADMIN_USER=postgres
# FINTRACE_DB_ADMIN_PASSWORD=
# Optional: give the background-worker and read-only auditor roles a login.
# FINTRACE_WORKER_PASSWORD=
# FINTRACE_AUDITOR_PASSWORD=

# --- Django ---
# ENV=production turns on HTTPS-only cookies, HSTS, the shared throttle cache, and
# refuses to start with DEBUG on or a placeholder SECRET_KEY.
ENV=development
DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Origins the browser loads the app from (scheme + host + port), comma separated.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Failed sign-ins before an identifier is locked out, and for how long (seconds).
FINTRACE_LOGIN_MAX_FAILURES=5
FINTRACE_LOGIN_LOCKOUT_SECONDS=900

# --- Zerodha (Kite + Coin) portfolio connection: optional ---
#
# Step 1. The redirect URL does NOT go in this file. It goes on Zerodha's side:
#   - Sign in at https://developers.kite.trade
#   - Open "My apps" and click your app
#   - Paste the URL below into the field named "Redirect URL", then save.
#
#     Local development:  http://127.0.0.1:3000/api/v1/integrations/zerodha/callback/
#     Production:         https://<your-domain>/api/v1/integrations/zerodha/callback/
#
#   It must match exactly, including the trailing slash. Locally, open the app at
#   http://127.0.0.1:3000 as well (not http://localhost:3000), or the sign-in fails
#   when Zerodha sends you back.
#
# Step 2. Copy "API key" and "API secret" from that same app page into the two
# lines below, and remove the leading "# ".
# KITE_API_KEY=
# KITE_API_SECRET=
#
# Step 3. A key used to encrypt the Zerodha access token in the database. Generate one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# and paste it below. (If left unset, one is derived from SECRET_KEY.)
# FINTRACE_TOKEN_ENCRYPTION_KEY=
#
# Step 4. Restart the backend, then in the app go to Investments > Zerodha portfolio
# and click "Connect Zerodha".
#
# Only needed if the app is NOT served from the same address as the API: where the
# browser should land after Zerodha's login page. Leave unset otherwise.
# FINTRACE_FRONTEND_URL=/
